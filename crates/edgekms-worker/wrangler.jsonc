{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgekms-dev",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-01",
  // Local only: a stray `wrangler deploy` of this config gets no workers.dev origin or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "worker-build --release" },
  "vars": { "EDGEKMS_CONFIG": { "root_id": "rdev", "keys": {}, "mounts": {}, "roles": {}, "policies": {} } },
  "kv_namespaces": [{ "binding": "REVOKED", "id": "local-revoked" }],
  "r2_buckets": [{ "binding": "AUDIT", "bucket_name": "edgekms-audit-dev" }],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "edgekms_dev" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_FAIL_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ]
}
